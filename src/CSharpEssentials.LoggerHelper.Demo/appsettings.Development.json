{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LoggerHelper": {
    "ApplicationName": "LoggerHelperDemo",
    "General": {
      "EnableSelfLogging": true,
      "EnableRequestResponseLogging": true,
      "EnableOpenTelemetry": false,
      "EnableRenderedMessage": true,
      "EnableContextualLogging": true,
      "ContextualBufferCapacity": 200
    },
    "SensitiveDataMasking": {
      "Enabled": true,
      "MaskText": "***MASKED***",
      "Presets": [
        "Email",
        "CreditCard",
        "JwtToken",
        "BearerToken",
        "ConnectionStringSecret"
      ],
      "SensitiveProperties": [
        "Password",
        "ApiKey"
      ],
      "Rules": [
        {
          "Name": "OrderId",
          "Pattern": "ORD-\\d+"
        }
      ]
    },
    "Routes": [
      {
        "Sink": "Console",
        "Levels": [
          "Debug",
          "Information",
          "Warning",
          "Error",
          "Fatal"
        ]
      },
      {
        "Sink": "File",
        "Levels": [
          "Information",
          "Warning",
          "Error",
          "Fatal"
        ]
      }
    ],
    "Sinks": {
      "File": {
        "Path": "Logs",
        "RollingInterval": "Day",
        "RetainedFileCountLimit": 7,
        "FileNameProperty": "TenantId"
      }
    }
  }
}
