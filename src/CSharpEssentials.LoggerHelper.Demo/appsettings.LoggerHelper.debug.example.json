{
  "LoggerHelper": {
    "ApplicationName": "LoggerHelperDemo",
    "General": {
      "EnableSelfLogging": true,
      "EnableRequestResponseLogging": true,
      "EnableOpenTelemetry": false,
      "EnableRenderedMessage": true,
      "EnableContextualLogging": true,
      "ContextualBufferCapacity": 200
    },
    "SensitiveDataMasking": {
      "Enabled": true,
      "MaskText": "***MASKED***",
      "Presets": [
        "Email",
        "CreditCard",
        "JwtToken",
        "BearerToken",
        "ConnectionStringSecret"
      ],
      "SensitiveProperties": [
        "Password",
        "ApiKey"
      ],
      "Rules": [
        {
          "Name": "OrderId",
          "Pattern": "ORD-\\d+"
        }
      ]
    },
    "Routes": [
      {
        "Sink": "Console",
        "Levels": [
          "Debug",
          "Information",
          "Warning",
          "Error",
          "Fatal"
        ]
      },
      {
        "Sink": "File",
        "Levels": [
          "Information",
          "Warning",
          "Error",
          "Fatal"
        ]
      },
      {
        "Sink": "Email",
        "Levels": [
          "Error",
          "Fatal"
        ]
      },
      {
        "Sink": "MSSqlServer",
        "Levels": [
          "Information"
        ]
      },
      {
        "Sink": "PostgreSQL",
        "Levels": [
          "Information",
          "Warning",
          "Error",
          "Fatal"
        ]
      },
      {
        "Sink": "Telegram",
        "Levels": [
          "Error",
          "Fatal"
        ]
      },
      {
        "Sink": "Elasticsearch",
        "Levels": [
          "Information",
          "Warning",
          "Error",
          "Fatal"
        ]
      },
      {
        "Sink": "Seq",
        "Levels": [
          "Information",
          "Warning",
          "Error",
          "Fatal"
        ]
      },
      {
        "Sink": "MySql",
        "Levels": [
          "Information",
          "Warning",
          "Error",
          "Fatal"
        ]
      }
    ],
    "Sinks": {
      "File": {
        "Path": "Logs",
        "RollingInterval": "Day",
        "RetainedFileCountLimit": 7,
        "FileNameProperty": "TenantId"
      },
      "Email": {
        "From": "<from-address>",
        "To": "<to-address>",
        "Host": "<smtp-host>",
        "Port": 587,
        "Username": "<smtp-user>",
        "Password": "<smtp-password>",
        "EnableSsl": true
      },
      "MSSqlServer": {
        "ConnectionString": "<mssqlserver-connection-string>",
        "TableName": "Logs",
        "SchemaName": "dbo",
        "AutoCreateSqlTable": true,
        "BatchPostingLimit": 100,
        "Period": "0.00:00:10",
        "AddStandardColumns": [
          "LogEvent",
          "Message",
          "MessageTemplate",
          "Level",
          "Exception"
        ],
        "RemoveStandardColumns": [
          "Properties"
        ],
        "AdditionalColumns": [
          {
            "ColumnName": "IdTransaction",
            "DataType": "NVarChar",
            "AllowNull": true
          },
          {
            "ColumnName": "Action",
            "DataType": "NVarChar",
            "AllowNull": true
          },
          {
            "ColumnName": "MachineName",
            "DataType": "NVarChar",
            "AllowNull": true
          },
          {
            "ColumnName": "ApplicationName",
            "DataType": "NVarChar",
            "AllowNull": true
          },
          {
            "ColumnName": "SpanName",
            "DataType": "NVarChar",
            "AllowNull": true
          }
        ]
      },
      "PostgreSql": {
        "ConnectionString": "<postgresql-connection-string>",
        "TableName": "logs",
        "SchemaName": "public",
        "NeedAutoCreateTable": true,
        "Columns": [
          {
            "Name": "message",
            "Writer": "Rendered",
            "Type": "Text"
          },
          {
            "Name": "message_template",
            "Writer": "Template",
            "Type": "Text"
          },
          {
            "Name": "level",
            "Writer": "Level",
            "Type": "Varchar"
          },
          {
            "Name": "raise_date",
            "Writer": "Timestamp",
            "Type": "Timestamp"
          },
          {
            "Name": "exception",
            "Writer": "Exception",
            "Type": "Text"
          },
          {
            "Name": "properties",
            "Writer": "Serialized",
            "Type": "Jsonb"
          },
          {
            "Name": "IdTransaction",
            "Writer": "Single",
            "Property": "IdTransaction",
            "Type": "Varchar"
          },
          {
            "Name": "Action",
            "Writer": "Single",
            "Property": "Action",
            "Type": "Varchar"
          },
          {
            "Name": "MachineName",
            "Writer": "Single",
            "Property": "MachineName",
            "Type": "Varchar"
          },
          {
            "Name": "ApplicationName",
            "Writer": "Single",
            "Property": "ApplicationName",
            "Type": "Varchar"
          },
          {
            "Name": "SpanName",
            "Writer": "Single",
            "Property": "SpanName",
            "Type": "Varchar"
          }
        ]
      },
      "Telegram": {
        "BotToken": "<telegram-bot-token>",
        "ChatId": "<telegram-chat-id>"
      },
      "Elasticsearch": {
        "NodeUris": "http://elasticsearch:9200/",
        "IndexFormat": "myapp-logs-{0:yyyy.MM.dd}"
      },
      "Seq": {
        "ServerUrl": "<seq-server-url>",
        "ApiKey": "<seq-api-key>"
      },
      "MySql": {
        "ConnectionString": "<mysql-connection-string>",
        "TableName": "logentry",
        "AutoCreateTable": false,
        "StoreTimestampInUtc": true,
        "BatchPostingLimit": 100,
        "Period": "0.00:00:05",
        "Columns": [
          {
            "Name": "message",
            "Writer": "Rendered",
            "Type": "Text"
          },
          {
            "Name": "messagetemplate",
            "Writer": "Template",
            "Type": "Text"
          },
          {
            "Name": "level",
            "Writer": "Level",
            "Type": "VarChar",
            "Length": 50
          },
          {
            "Name": "timestamp",
            "Writer": "Timestamp",
            "Type": "DateTime"
          },
          {
            "Name": "exception",
            "Writer": "Exception",
            "Type": "Text"
          },
          {
            "Name": "properties",
            "Writer": "Properties",
            "Type": "Json"
          },
          {
            "Name": "logevent",
            "Writer": "Serialized",
            "Type": "Json"
          },
          {
            "Name": "idtransaction",
            "Writer": "Single",
            "Type": "VarChar",
            "Length": 50,
            "Property": "IdTransaction"
          },
          {
            "Name": "machinename",
            "Writer": "Single",
            "Type": "VarChar",
            "Length": 50,
            "Property": "MachineName"
          },
          {
            "Name": "action",
            "Writer": "Single",
            "Type": "VarChar",
            "Length": 50,
            "Property": "Action"
          },
          {
            "Name": "applicationname",
            "Writer": "Single",
            "Type": "VarChar",
            "Length": 50,
            "Property": "ApplicationName"
          },
          {
            "Name": "ProviderName",
            "Writer": "Single",
            "Type": "VarChar",
            "Length": 50,
            "Property": "ProviderName"
          }
        ]
      }
    }
  }
}
